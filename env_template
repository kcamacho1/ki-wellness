# Ki Wellness Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ki_wellness

# SendGrid Email Configuration
SENDGRID_API_KEY=your-sendgrid-api-key-here

# Email Settings
FROM_EMAIL=your-email@example.com
FROM_NAME=Ki Wellness

# Application Settings
# APP_URL is auto-detected in production (uses https://kiwellness.org)
# Only set this if you need to override the auto-detection
APP_URL=http://localhost:5000
SECRET_KEY=your-secret-key-here

# Security Settings
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Stripe Configuration - Auto-detected environment
# Use pk_test_... and sk_test_... for development
# Use pk_live_... and sk_live_... for production
STRIPE_PUBLISHABLE_KEY=pk_test_... or pk_live_...
STRIPE_SECRET_KEY=sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs for different environments (get these from your Stripe Dashboard)
STRIPE_TEST_PREMIUM_PRICE_ID=price_test_...
STRIPE_LIVE_PREMIUM_PRICE_ID=price_live_...

# Legacy fallback (will be auto-detected based on environment)
STRIPE_PREMIUM_PRICE_ID=price_1S1Wjb6d7DUvK3X6cz3XoG97
