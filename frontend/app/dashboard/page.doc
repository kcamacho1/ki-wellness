'use client'; // Enable client-side rendering for this Next.js page

// Import necessary hooks and tools
import { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { supabase } from '@/lib/supabaseClient';
import { User } from '@supabase/supabase-js';
import { format, subDays } from 'date-fns'; // Import date utility functions
import { Download } from 'lucide-react'; // Import the download icon from lucide-react

// Import modular components
import FoodJournalForm from '@/components/FoodJournalForm'; // Still used inside DashboardModal
import FoodJournalTable from '@/components/FoodJournalTable';
import DashboardModal from '@/components/DashboardModal';

// Charting components
import { BarChart, Bar, XAxis, YAxis, Tooltip, Legend, ResponsiveContainer } from 'recharts';

import './papyrus.css'; // Custom styling (e.g. Papyrus font)

export default function DashboardPage() {
  const router = useRouter();

  // State to track the logged-in user
  const [user, setUser] = useState<User | null>(null);
  // State to manage the overall loading state of the dashboard
  const [loading, setLoading] = useState(true);

  // State to store food journal entries fetched from the database
  const [entries, setEntries] = useState<any[]>([]);

  // States for AI Nutrition feedback and analysis status
  const [aiFeedback, setAiFeedback] = useState('');
  const [analyzing, setAnalyzing] = useState(false);

  // State for controlling the visibility of the DashboardModal
  const [isModalOpen, setIsModalOpen] = useState(false);

  // States for date range filtering of the displayed food journal entries
  const [startDate, setStartDate] = useState<string>('');
  const [endDate, setEndDate] = useState<string>('');

  /**
   * Calculate total nutritional values from current entries for the RDA chart.
   * IMPORTANT: Ensure that values from Supabase are parsed as numbers using parseFloat()
   * to prevent "string is not assignable to number" errors if they are fetched as strings.
   */
  const totalProtein = entries.reduce((sum, e) => sum + (parseFloat(e.protein_g) || 0), 0);
  const totalCarbs = entries.reduce((sum, e) => sum + (parseFloat(e.carbs_g) || 0), 0);
  const totalFat = entries.reduce((sum, e) => sum + (parseFloat(e.fat_g) || 0), 0);
  const totalCalories = entries.reduce((sum, e) => sum + (parseFloat(e.calories) || 0), 0);

  /**
   * Data for the Recommended Daily Allowance (RDA) chart.
   */
  const rdaChartData = [
    { name: 'Protein (g)', Intake: totalProtein, RDA: 50 },
    { name: 'Carbs (g)', Intake: totalCarbs, RDA: 275 },
    { name: 'Fat (g)', Intake: totalFat, RDA: 70 },
    { name: 'Calories', Intake: totalCalories, RDA: 2000 }
  ];

  /**
   * 1️⃣ useEffect hook to check user authentication on component mount.
   * Redirects to login page if no user is found, otherwise sets the user and clears loading state.
   */
  useEffect(() => {
    supabase.auth.getUser().then(({ data }) => {
      if (!data?.user) {
        router.push('/login'); // Redirect if not logged in
      } else {
        setUser(data.user);
        setLoading(false); // Allow dashboard to load once user is confirmed
      }
    });
  }, [router]); // Dependency on 'router' to ensure effect runs when router is ready

  /**
   * 2️⃣ useEffect hook to set default date range (current week).
   * This runs once on component mount to initialize the date filters.
   */
  useEffect(() => {
    const today = new Date();
    const defaultEndDate = format(today, 'yyyy-MM-dd');
    const defaultStartDate = format(subDays(today, 6), 'yyyy-MM-dd'); // 6 days before 'today' for a full 7-day week

    setEndDate(defaultEndDate);
    setStartDate(defaultStartDate);
  }, []); // Empty dependency array means this effect runs only once after the initial render

  /**
   * 3️⃣ useEffect hook to fetch food journal entries from Supabase based on the date range.
   * This effect runs on component mount, whenever 'startDate', 'endDate' change, or when 'isModalOpen' changes
   * (specifically, when it becomes false after closing the modal, indicating a new entry might have been saved).
   */
  useEffect(() => {
    // Ensure startDate and endDate are set before attempting to fetch
    if (!startDate || !endDate) return;

    const fetchEntries = async () => {
      const { data, error } = await supabase
        .from('food_journal')
        .select('*')
        .gte('date', startDate) // Filter entries greater than or equal to startDate
        .lte('date', endDate)   // Filter entries less than or equal to endDate
        .order('date', { ascending: false }); // Order entries by date descending

      if (data && !error) {
        setEntries(data); // Update the entries state with filtered data
      } else {
        console.error('Failed to fetch entries:', error); // Log any errors during fetching
      }
    };

    fetchEntries(); // Call the fetch function
  }, [startDate, endDate, isModalOpen]); // Dependencies: Re-fetch entries when these states change

  /**
   * Function to handle successful food entry saving.
   * Closes the modal and triggers a re-fetch of entries by changing `isModalOpen` state,
   * which in turn updates the `entries` state and refreshes the table.
   */
  const handleEntrySavedAndReload = () => {
    setIsModalOpen(false); // Close the modal
  };

  /**
   * Function to handle AI Nutrition Analysis.
   * Sends current entries to a backend API for analysis and updates feedback state.
   */
  const handleAnalyze = async () => {
    setAnalyzing(true); // Set analyzing state to true to show loading indicator

    try {
      const res = await fetch('https://ki-wellness-75gt.onrender.com/api/ai-nutrition-analysis', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ entries }) // Send current entries for analysis
      });

      const data = await res.json(); // Parse the JSON response
      setAiFeedback(data.message || 'No feedback returned.'); // Update AI feedback
    } catch (error) {
      console.error('Error fetching AI analysis:', error);
      setAiFeedback('Failed to get AI feedback. Please try again.');
    } finally {
      setAnalyzing(false); // Set analyzing state to false when analysis is complete
    }
  };

  /**
   * Function to download the currently displayed food journal entries as a CSV file.
   */
  const handleDownloadCSV = () => {
    if (entries.length === 0) {
      // In a production app, you'd use a custom modal instead of alert
      alert('No data to download for the selected date range.');
      return;
    }

    // Define CSV headers from the keys of the first entry (assuming consistent structure)
    const headers = Object.keys(entries[0]).join(',');
    // Map entries to CSV rows, handling potential commas or newlines within cell values
    const csvRows = entries.map(entry =>
      Object.values(entry)
        .map(value => {
          if (typeof value === 'string' && (value.includes(',') || value.includes('\n') || value.includes('"'))) {
            // Escape double quotes by doubling them, then enclose the whole value in double quotes
            return `"${value.replace(/"/g, '""')}"`;
          }
          return value; // Return as-is for non-string or clean string values
        })
        .join(',')
    );

    // Combine headers and data rows into a single CSV string
    const csvContent = [headers, ...csvRows].join('\n');
    // Create a Blob containing the CSV data with UTF-8 encoding
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    // Create a temporary anchor element to trigger the download
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob); // Set the Blob URL as the link's href
    // Set the download attribute with a descriptive filename including the date range
    link.setAttribute('download', `food_journal_data_${startDate}_to_${endDate}.csv`);
    document.body.appendChild(link); // Append link to the body (necessary for Firefox)
    link.click(); // Programmatically click the link to trigger download
    document.body.removeChild(link); // Remove the link after download
    URL.revokeObjectURL(link.href); // Clean up the URL object to free memory
  };

  /**
   * 4️⃣ Display a loading screen until the dashboard data is ready.
   */
  if (loading) {
    return (
      <main className="min-h-screen bg-green-900 text-white flex items-center justify-center font-inter">
        <p>Loading your dashboard...</p>
      </main>
    );
  }

  /**
   * 5️⃣ Render the main dashboard UI.
   */
  return (
    <main className="min-h-screen bg-green-900 text-gray-100 p-6 space-y-4 font-inter">

      {/* Header Section: App Name and Log Out Button */}
      <section className="max-w-6xl mx-auto bg-amber-50 p-6 rounded-xl shadow text-gray-800">
        <div className="text-right">
          <button
            onClick={async () => {
              await supabase.auth.signOut(); // Sign out the user
              router.push('/login'); // Redirect to login page
            }}
            className="text-sm text-green-800 underline hover:text-red-600 transition-colors"
          >
            Log out
          </button>
        </div>
        <h1 className="text-4xl font-bold text-green-800 papyrus mb-2">your dashboard</h1>
        <p className="text-gray-700">Journal your food, track your wellness, and analyze nutrition.</p>
      </section>

      {/* Food Journal Section: Contains the options button, table, chart, and AI analysis */}
      <section className="max-w-6xl mx-auto bg-amber-50 p-6 rounded-xl shadow text-gray-800 space-y-6">
        <h2 className="text-2xl font-bold text-green-800 papyrus mb-4">🥗 Food Journal</h2>

        {/* Layout for Food Journal Table and RDA Chart */}
        <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
          {/* Food Journal Table and its controls (left column) */}
          <div className="md:col-span-3">
            {/* Header, Download Button, and Date Range Filters */}
            <div className="flex justify-between items-center mb-4">
              <h3 className="text-xl font-semibold text-green-800">Food Entries</h3>
              {/* Download Button */}
              <button
                onClick={handleDownloadCSV}
                className="bg-green-600 text-white p-2 rounded-full shadow-md hover:bg-green-700 transition-colors flex items-center justify-center transform hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50"
                title="Download Food Journal Data"
              >
                <Download size={20} /> {/* Lucide React Download icon */}
              </button>
            </div>

            {/* Date Range Filters */}
            <div className="flex flex-col sm:flex-row gap-4 mb-6 p-4 bg-amber-100 rounded-lg shadow-inner">
                <div className="flex-1">
                    <label htmlFor="startDate" className="block text-gray-700 text-sm font-bold mb-1">From:</label>
                    <input
                    type="date"
                    id="startDate"
                    value={startDate}
                    onChange={(e) => setStartDate(e.target.value)}
                    className="shadow appearance-none border border-gray-300 rounded-lg w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-green-500 transition-all bg-white"
                    />
                </div>
                <div className="flex-1">
                    <label htmlFor="endDate" className="block text-gray-700 text-sm font-bold mb-1">To:</label>
                    <input
                    type="date"
                    id="endDate"
                    value={endDate}
                    onChange={(e) => setEndDate(e.target.value)}
                    className="shadow appearance-none border border-gray-300 rounded-lg w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-green-500 transition-all bg-white"
                    />
                </div>
            </div>

            {/* Food Journal Table Container with scroll */}
            <div className="max-h-[500px] overflow-auto rounded-lg shadow-md bg-white">
              <FoodJournalTable entries={entries} />
            </div>

            {/* NEW: Container for "Enter Food" and "AI Analysis" buttons */}
            <div className="mt-6 flex flex-col md:flex-row md:justify-between items-center gap-4">
                {/* "Enter Food" button (left) */}
                <button
                    onClick={() => setIsModalOpen(true)}
                    className="bg-green-700 text-white px-8 py-3 rounded-full shadow-lg hover:bg-green-800 transition-all transform hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50 text-lg font-semibold w-full md:w-auto"
                >
                    Enter Food
                </button>

                {/* AI Analysis (right, potentially centered within its own space) */}
                <div className="flex flex-col items-center w-full md:w-auto">
                    <button
                        onClick={handleAnalyze}
                        className="bg-green-800 text-white px-6 py-3 rounded-full hover:bg-green-900 transition-colors shadow-md text-lg font-semibold w-full md:w-auto"
                        disabled={analyzing}
                    >
                        {analyzing ? 'Analyzing...' : '🧠 AI review gaps and recommend'}
                    </button>

                    {aiFeedback && (
                        <div className="mt-4 bg-green-100 text-green-900 p-4 rounded-lg text-sm w-full max-w-lg shadow-inner md:max-w-xs lg:max-w-sm">
                            <strong>AI Recommendation:</strong>
                            <p>{aiFeedback}</p>
                        </div>
                    )}
                </div>
            </div>
          </div>

          {/* RDA Chart (right column) */}
          <div className="md:col-span-1 mt-6 md:mt-0 bg-white p-4 rounded-lg shadow-md">
            <h3 className="text-xl font-semibold text-green-800 mb-2">📊 Your Averages vs. RDA</h3>
            <ResponsiveContainer width="100%" height={300}>
              <BarChart data={rdaChartData} margin={{ top: 20, right: 30, left: 0, bottom: 5 }}>
                <XAxis dataKey="name" axisLine={false} tickLine={false} />
                <YAxis axisLine={false} tickLine={false} />
                <Tooltip cursor={{ fill: 'transparent' }} />
                <Legend layout="horizontal" verticalAlign="top" align="center" wrapperStyle={{ paddingBottom: '10px' }} />
                <Bar dataKey="RDA" fill="#8884d8" name="RDA" radius={[10, 10, 0, 0]} /> {/* Rounded top corners */}
                <Bar dataKey="Intake" fill="#82ca9d" name="Your Intake" radius={[10, 10, 0, 0]} /> {/* Corrected dataKey and added name */}
              </BarChart>
            </ResponsiveContainer>
          </div>
        </div>
      </section>

      {/* SECTION: Meal Planner */}
      <section className="w-full max-w-6xl mx-auto bg-amber-50 text-gray-800 p-6 rounded-xl shadow-md space-y-2">
        <h2 className="text-2xl font-bold text-green-800 papyrus">📅 Meal Planner</h2>
        <p>Get personalized meal ideas based on your health goals.</p>
        {/* Placeholder for future Meal Planner content */}
      </section>

      {/* SECTION: Exercise Playlist */}
      <section className="w-full max-w-6xl mx-auto bg-amber-50 text-gray-800 p-6 rounded-xl shadow-md space-y-2">
        <h2 className="text-2xl font-bold text-green-800 papyrus">💪 Exercise Playlist</h2>
        <p>Curated workouts and suggestions based on your fitness level.</p>
        {/* Example Cards for Exercise Playlist */}
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
          {[
            {
              title: "10-Minute Morning Workout",
              url: "https://www.youtube.com/watch?v=UBMk30rjy0o",
              thumbnail: "https://img.youtube.com/vi/UBMk30rjy0o/0.jpg",
              duration: "10:21"
            },
            {
              title: "15-Min Bodyweight HIIT",
              url: "https://www.youtube.com/watch?v=ml6cT4AZdqI",
              thumbnail: "https://img.youtube.com/vi/ml6cT4AZdqI/0.jpg",
              duration: "15:12"
            }
          ].map(({ title, url, thumbnail, duration }) => (
            <a
              key={title}
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              className="block bg-white rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-transform transform hover:scale-105"
            >
              <img src={thumbnail} alt={title} className="w-full h-48 object-cover" />
              <div className="p-4 text-gray-800">
                <h3 className="text-lg font-bold">{title}</h3>
                <p className="text-sm text-green-700">Duration: {duration}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

      {/* SECTION: Spiritual Playlist */}
      <section className="w-full max-w-6xl mx-auto bg-amber-50 text-gray-800 p-6 rounded-xl shadow-md space-y-2">
        <h2 className="text-2xl font-bold text-green-800 papyrus">🧘‍♀️ Spiritual Playlist</h2>
        <p>Mindful practices, meditations, and journaling prompts.</p>
        {/* Example Cards for Spiritual Playlist */}
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
          {[
            {
              title: "10-Minute Meditation Workout",
              url: "https://www.youtube.com/watch?v=-9KLB2HI9BI",
              thumbnail: "https://img.youtube.com/vi/-9KLB2HI9BI/0.jpg",
              duration: "10:54"
            },
            {
              title: "Breathwork for Stress Relief",
              url: "https://www.youtube.com/watch?v=DbDoBzGY3vo",
              thumbnail: "https://img.youtube.com/vi/DbDoBzGY3vo/0.jpg",
              duration: "15:12"
            }
          ].map(({ title, url, thumbnail, duration }) => (
            <a
              key={title}
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              className="block bg-white rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-transform transform hover:scale-105"
            >
              <img src={thumbnail} alt={title} className="w-full h-48 object-cover" />
              <div className="p-4 text-gray-800">
                <h3 className="text-lg font-bold">{title}</h3>
                <p className="text-sm text-green-700">Duration: {duration}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

      {/* The DashboardModal Component: Rendered conditionally based on isModalOpen state */}
      {isModalOpen && (
        <DashboardModal
          isOpen={isModalOpen}
          onClose={() => setIsModalOpen(false)} // Function to close the modal
          user={user}
          onEntrySaved={handleEntrySavedAndReload} // Callback for when an entry is saved inside the modal
        />
      )}
    </main>
  );
}






{/* Personal Trainer AI Assistant */}
        <div className="flex justify-center">
          <AISidebar currentPanel={activePanel} />
        </div>

        {/* Top collapsed panels */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <DashboardPanel
            title="Recipe Book"
            icon={<BookOpen />}
            onActivate={setActivePanel}
          >
            <div>Recipe Book content here.</div>
          </DashboardPanel>
          <DashboardPanel
            title="Exercise Playlist"
            icon={<Dumbbell />}
            onActivate={setActivePanel}
          >
            <div>Exercise Playlist content here.</div>
          </DashboardPanel>
          <DashboardPanel
            title="Spiritual Playlist"
            icon={<Sparkles />}
            onActivate={setActivePanel}
          >
            <div>Spiritual Playlist content here.</div>
          </DashboardPanel>
        </div>

        {/* Always expanded panels */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <DashboardPanel
            title="Food Journal"
            icon={<Notebook />}
            defaultExpanded
            onActivate={setActivePanel}
          >
            <div>Food Journal content here.</div>
          </DashboardPanel>
          <DashboardPanel
            title="Charts"
            icon={<BarChart3 />}
            defaultExpanded
            onActivate={setActivePanel}
          >
            <div>Charts content here.</div>
          </DashboardPanel>
          <DashboardPanel
            title="AI Analysis"
            icon={<BrainCircuit />}
            defaultExpanded
            onActivate={setActivePanel}
          >
            <div>AI Analysis content here.</div>
          </DashboardPanel>
        </div>
      </section>